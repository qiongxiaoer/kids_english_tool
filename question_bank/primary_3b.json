  "sentences": [
    {
      "en": "What's your name?",
      "zh": "你叫什么名字？"
    },
    {
      "en": "My name's Amy Green.",
      "zh": "我叫埃米·格林。"
    },
    {
      "en": "Where are you from?",
      "zh": "你是哪里人？"
    },
    {
      "en": "I'm from the UK.",
      "zh": "我是英国人。"
    },
    {
      "en": "Let me help.",
      "zh": "我来帮忙。"
    },
    {
      "en": "After you!",
      "zh": "您先请！"
    },
    {
      "en": "You're welcome.",
      "zh": "别客气。"
    },
    {
      "en": "Who's that girl?",
      "zh": "那个女孩是谁？"
    },
    {
      "en": "That's our new neighbour, Amy.",
      "zh": "是我们的新邻居埃米。"
    },
    {
      "en": "It has a long body and short legs.",
      "zh": "它有长长的身体和短短的腿。"
    },
    {
      "en": "Dogs are friendly.",
      "zh": "狗是友善的。"
    },
    {
      "en": "Do you often say that to your mum?",
      "zh": "你经常对妈妈那么说吗？"
    },
    {
      "en": "Yes, I do.",
      "zh": "是的。"
    },
    {
      "en": "I often make her gifts.",
      "zh": "我经常给她做礼物。"
    },
    {
      "en": "We express ourselves in many ways.",
      "zh": "我们用很多种方式表达自己。"
    },
    {
      "en": "Excuse me.",
