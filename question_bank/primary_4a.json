  "grammar": [
    {
      "category": "be动词",
      "question": "They ___ my friends.",
      "options": [
        "am",
        "is",
        "are",
        "be"
      ],
      "answer": 2,
      "explain": "主语 they 是复数，用 are。",
      "question_zh": "他们是我的朋友。"
    },
    {
      "category": "复数",
      "question": "I have two ___.",
      "options": [
        "apple",
        "apples",
        "appless",
        "an apple"
      ],
      "answer": 1,
      "explain": "two 后面用名词复数 apples。",
      "question_zh": "我有两个苹果。"
    },
    {
      "category": "情态动词",
      "question": "You ___ cross the road now. It's red.",
      "options": [
        "can",
        "can't",
        "mustn't",
        "don't"
      ],
      "answer": 1,
      "explain": "红灯时不能过马路，用 can't 表示禁止。",
      "question_zh": "你现在不能过马路。是红灯。"
    },
    {
      "category": "时间介词",
      "question": "I go to school ___ Monday.",
      "options": [
        "in",
        "at",
        "on",
        "to"
      ],
      "answer": 2,
      "explain": "具体星期几前用 on。",
      "question_zh": "我星期一去上学。"
    }
  ]
}